[Unit]
Description=MinimalDesk attended remote desktop relay
After=network.target

[Service]
Type=simple
User=minimaldesk
Group=minimaldesk
WorkingDirectory=/opt/minimaldesk/server
Environment=MINIDESK_DATA=/var/lib/minimaldesk
Environment=MINIDESK_LISTEN=127.0.0.1:8080
Environment=MINIDESK_MAX_CLIENTS=20
ExecStart=/usr/bin/php /opt/minimaldesk/server/relay.php
Restart=on-failure
RestartSec=3
StateDirectory=minimaldesk
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minimaldesk
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
